# RepoMind Environment Variables Configuration
# Copy this file to .env for local development

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication (Better Auth)
BETTER_AUTH_SECRET="your-better-auth-secret-key-32-chars-minimum"
BETTER_AUTH_URL="http://localhost:3000"

# Email Configuration (for password reset)
GMAIL_USER="your-email@gmail.com"
GMAIL_PASS="your-gmail-app-password"

# Razorpay Payment Gateway (Test Mode / Free)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-secret"

# Google Gemini AI (For code embeddings & Q&A)
GEMINI_API_KEY="your-gemini-api-key"

# GitHub Integration (Optional - for increased GitHub API rate limits)
GITHUB_ACCESS_TOKEN="your-github-pat"

# Database (PostgreSQL with pgvector - Supabase / Neon)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
SKIP_ENV_VALIDATION=true
